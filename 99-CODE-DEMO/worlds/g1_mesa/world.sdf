<?xml version="1.0" ?>
<!--
  Humanoide Unitree G1 delante de una mesa con una manzana y una botella.

  El G1 va anclado por la pelvis (no hay controlador de equilibrio), así que el
  mundo sirve para manipulación con los brazos, no para andar.
  Modelo generado con tools/build_unitree_models.py; necesita
  GZ_SIM_RESOURCE_PATH=<este directorio>/models.

  Mover una articulación (radianes):
    gz topic -t /g1/cmd/left_shoulder_pitch_joint -m gz.msgs.Double -p "data: -0.8"

  Estado de las articulaciones y cámara de la cabeza:
    gz topic -e -t /g1/joint_states
    gz topic -e -t /g1/camara
-->
<sdf version="1.11">
  <world name="g1_mesa">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.4 -1.6 1.7 0 0.35 2.55</pose>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient>
            <diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pelvis a la altura de pie del G1 (+3 cm para que los pies no rocen), mirando a +X (hacia la mesa) -->
    <include>
      <uri>model://g1</uri>
      <name>g1</name>
      <pose>0 0 0.82 0 0 0</pose>
    </include>

    <!-- Mesa: tablero de 0.6 x 1.0 m a 0.70 m de altura -->
    <model name="mesa">
      <static>true</static>
      <pose>0.55 0 0 0 0 0</pose>
      <link name="link">
        <collision name="tablero_col">
          <pose>0 0 0.685 0 0 0</pose>
          <geometry><box><size>0.6 1.0 0.03</size></box></geometry>
        </collision>
        <visual name="tablero">
          <pose>0 0 0.685 0 0 0</pose>
          <geometry><box><size>0.6 1.0 0.03</size></box></geometry>
          <material>
            <ambient>0.55 0.38 0.22 1</ambient>
            <diffuse>0.55 0.38 0.22 1</diffuse>
          </material>
        </visual>
        <visual name="pata_1">
          <pose>0.26 0.46 0.335 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.67</size></box></geometry>
          <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="pata_2">
          <pose>0.26 -0.46 0.335 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.67</size></box></geometry>
          <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="pata_3">
          <pose>-0.26 0.46 0.335 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.67</size></box></geometry>
          <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="pata_4">
          <pose>-0.26 -0.46 0.335 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.67</size></box></geometry>
          <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Manzana: esfera de 8 cm, 150 g, a la izquierda del robot -->
    <model name="manzana">
      <pose>0.42 0.18 0.74 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>9.6e-5</ixx><iyy>9.6e-5</iyy><izz>9.6e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material>
            <ambient>0.75 0.08 0.05 1</ambient>
            <diffuse>0.75 0.08 0.05 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
        <visual name="rabito">
          <pose>0 0 0.045 0 0 0</pose>
          <geometry><cylinder><radius>0.003</radius><length>0.02</length></cylinder></geometry>
          <material><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Botella: cilindro de 7 cm de diámetro y 22 cm de alto, 300 g, a la derecha -->
    <model name="botella">
      <pose>0.42 -0.18 0.81 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.3</mass>
          <inertia>
            <ixx>1.3e-3</ixx><iyy>1.3e-3</iyy><izz>1.8e-4</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="cuerpo_col">
          <geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="cuerpo">
          <geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.45 0.25 0.8</ambient>
            <diffuse>0.15 0.45 0.25 0.8</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <visual name="cuello">
          <pose>0 0 0.13 0 0 0</pose>
          <geometry><cylinder><radius>0.014</radius><length>0.04</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.45 0.25 0.8</ambient>
            <diffuse>0.15 0.45 0.25 0.8</diffuse>
          </material>
        </visual>
        <visual name="tapon">
          <pose>0 0 0.155 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.015</length></cylinder></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
